---
import { icons, type IconName } from './icons';

interface Props {
  name: IconName;
  class?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
}

const { 
  name, 
  class: className = '',
  size = 'md'
} = Astro.props;

const sizeClasses = {
  sm: 'w-4 h-4',
  md: 'w-6 h-6',
  lg: 'w-8 h-8',
  xl: 'w-10 h-10'
};

const pathData = icons[name];
---

<svg
  class={`shrink-0 ${sizeClasses[size]} ${className}`}
  fill="none"
  stroke="currentColor"
  viewBox="0 0 24 24"
>
  <path
    stroke-linecap="round"
    stroke-linejoin="round"
    stroke-width="2"
    d={pathData}
  ></path>
</svg>
