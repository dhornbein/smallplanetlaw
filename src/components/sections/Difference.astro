---
import LogoMark from "../ui/LogoMark.astro";
import CurvedEdge from "../ui/CurvedEdge.astro";
import Icon from "../ui/Icon.astro";
import Markdown from "../ui/Markdown.astro";
import type { IconName } from "../ui/icons";

interface Props {
  heading: string;
  subheading: string;
  body: string;
  features: { icon: IconName; title: string; description: string }[];
}

const { heading, subheading, body, features } = Astro.props;
---

<section class="relative py-20 lg:py-40 bg-neutral-warm text-text-primary">
  <CurvedEdge fillColor="fill-neutral-warm" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <LogoMark size="xl" class="mx-auto mb-6" fillColor="none" />
      <h2>{heading}</h2>
      <p class="text-xl leading-relaxed">
        {subheading}
      </p>
      <Markdown content={body} class="text-lg mt-4 leading-relaxed" />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
      {
        features.map((feature) => (
          <div class="text-center space-y-4">
            <div class="flex justify-center mb-4">
              <Icon name={feature.icon} size="xl" class="text-primary" />
            </div>
            <h3>{feature.title}</h3>
            <Markdown content={feature.description} class="leading-relaxed" />
          </div>
        ))
      }
    </div>
  </div>
</section>
