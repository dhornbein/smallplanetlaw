---
import Markdown from "../ui/Markdown.astro";
import Button from "../ui/Button.astro";
import CurvedEdge from "../ui/CurvedEdge.astro";
import leaf from "../../assets/leaf.jpg";
import { Image } from "astro:assets";

interface Props {
  heading: string;
  cards: { title: string; description: string }[];
  buttonLabel: string;
}

const { heading, cards, buttonLabel } = Astro.props;
---

<section class="relative pt-30 bg-neutral-cool">
  <CurvedEdge fillColor="fill-neutral-cool" />
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <Image src={leaf} alt="Leaf" class="mx-auto max-h-80 w-auto" />
    <div class="text-center mb-12">
      <h2>{heading}</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      {
        cards.map((service) => (
          <div class="bg-white/60 rounded-lg p-8 shadow-sm hover:shadow-md transition-shadow duration-300">
            <h3>
              {service.title}
            </h3>
            <Markdown content={service.description} class="text-text-secondary leading-relaxed mb-6" />
          </div>
        ))
      }
    </div>

    <div class="text-center">
      <Button href="/services" variant="primary" size="xl">
        {buttonLabel}
      </Button>
    </div>
  </div>
</section>
