---
import CurvedEdge from "../ui/CurvedEdge.astro";
import BookCover from "../ui/BookCover.astro";
import Button from "../ui/Button.astro";
import portraitShadow from "../../assets/hero-shadow-wide.jpg";
import portraitShadowTall from "../../assets/hero-shadow-tall.jpg";
import { getCollection } from "astro:content";
import { getSingleton } from "../../utils/content";
import { fillTemplate } from "../../utils/template";

interface Props {
  /** Force a specific lead magnet variant by its id (e.g. "green-ep-guide"). Omit for random A/B selection. */
  variant?: string;
}

const { variant } = Astro.props;

const leadMagnets = (await getCollection("leadMagnets")).map((entry) => ({
  id: entry.id,
  ...entry.data,
}));

// Text shared by every guide form, edited in Keystatic (Settings > Newsletter signup)
const { guide, fields, emailCheck, messages } = await getSingleton("newsletter");
---

<section id="lead" class="relative pb-40 bg-neutral-warm">
  <lead-generator class="block" data-forced-variant={variant ?? ""} data-failed={messages.failed}>
    {leadMagnets.map((magnet, index) => (
      <div
        class="lead-variant hidden"
        data-variant={magnet.id}
        data-tag={magnet.tag}
      >
        <!-- Hero image with overlaid title -->
        <div
          class="relative shadow-lg mb-8 bg-var bg-cover bg-center"
          style={`--bg-img: url(${portraitShadowTall.src}); --bg-img-md: url(${portraitShadow.src});`}
        >
          <div class=" bg-outer-space-900/60 flex items-center justify-center">
            <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12 px-4 sm:px-6 max-w-4xl">
              {magnet.cover && (
                <a href={`#free-${magnet.id}`} class="shrink-0 -mt-6 md:mt-0">
                  <BookCover
                    src={magnet.cover}
                    alt={`${magnet.title} cover`}
                    size="lg"
                  />
                </a>
              )}
              <div class="text-center md:text-left text-white">
                <p class="text-sm font-semibold uppercase tracking-wider text-olivine-300 mb-3">
                  {guide.eyebrow}
                </p>
                <h2 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-white mb-0">
                  {magnet.title}
                </h2>
              </div>
            </div>
          </div>
        </div>

        <!-- Teaser, bullets & form -->
        <div id={`free-${magnet.id}`} class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center scroll-m-24">
          <p class="text-xl text-text-secondary mb-8 leading-relaxed max-w-2xl mx-auto">
            {magnet.teaser}
          </p>

          <ul class="lead-bullets text-left max-w-md mx-auto mb-10 space-y-3">
            {magnet.bullets.map((bullet) => (
              <li class="flex items-start gap-3 text-text-secondary">
                <svg class="shrink-0 w-5 h-5 text-primary mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>{bullet}</span>
              </li>
            ))}
          </ul>

          <!-- Form -->
          <form class="lead-form max-w-md mx-auto" method="POST" action="/api/newsletter">
            <input type="hidden" name="tags" value={magnet.tag} />
            <div class="space-y-3">
              <div>
                <label for={`lead-email-${index}`} class="sr-only">{fields.emailLabel}</label>
                <input
                  type="email"
                  id={`lead-email-${index}`}
                  name="email"
                  required
                  autocomplete="email"
                  aria-describedby={`lead-email-check-${index}`}
                  class="w-full px-4 py-3 rounded-md border border-neutral text-text-primary placeholder-outer-space-300 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
                  placeholder={fields.emailPlaceholder}
                />
                <!-- Possible typo in the email, e.g. "gmial.com" -->
                <div
                  id={`lead-email-check-${index}`}
                  class="email-check mt-2 p-3 rounded-md bg-amber-50 border border-amber-400 text-amber-900 text-sm text-left hidden"
                  data-suggestion={emailCheck.suggestion}
                  data-missing-ending={emailCheck.missingEnding}
                  role="status"
                  aria-live="polite"
                >
                  <p class="email-check-text"></p>
                  <p class="email-check-note mt-1 hidden">
                    {fillTemplate(emailCheck.submitAgain, { button: magnet.buttonText })}
                  </p>
                </div>
              </div>
              <div>
                <label for={`lead-name-${index}`} class="sr-only">{fields.firstNameLabel}</label>
                <input
                  type="text"
                  id={`lead-name-${index}`}
                  name="firstName"
                  required
                  autocomplete="given-name"
                  class="w-full px-4 py-3 rounded-md border border-neutral text-text-primary placeholder-outer-space-300 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
                  placeholder={fields.firstNameLabel}
                />
              </div>
              <Button
                type="submit"
                variant="accent"
                size="lg"
                class="w-full font-medium disabled:opacity-50 disabled:cursor-not-allowed"
              >
                <span class="submit-text">{magnet.buttonText}</span>
                <span class="loading-text hidden">{fields.sending}</span>
              </Button>
            </div>

            <!-- Success message -->
            <div class="success-message mt-6 p-6 rounded-lg bg-hunter-green-100 border border-hunter-green-400 text-text-primary hidden" role="alert">
              <div class="flex items-center gap-3 mb-3">
                <svg class="w-8 h-8 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <p class="font-serif font-bold text-lg">{guide.successHeading}</p>
              </div>
              <p class="text-sm text-text-secondary mb-4">{guide.successBody}</p>
              <Button
                href={magnet.downloadUrl}
                download
                variant="primary"
                size="md"
                class="w-full sm:w-auto font-medium"
              >
                {guide.downloadButton}
              </Button>
            </div>

            <!-- Error message -->
            <div class="error-message mt-4 p-4 rounded-md bg-redwood-100 border border-redwood-400 text-text-primary hidden" role="alert">
              <p class="error-text"></p>
            </div>

            <p class="text-xs text-text-secondary text-center mt-4">{fields.privacy}</p>
          </form>
        </div>
      </div>
    ))}
  </lead-generator>

  <CurvedEdge fillColor="fill-neutral-warm" position="bottom" />
</section>

<script>
  import { attachEmailCheck } from "../../utils/emailCheckUI";

  class LeadGeneratorElement extends HTMLElement {
    connectedCallback() {
      const variants = this.querySelectorAll('.lead-variant');
      if (variants.length === 0) return;

      // Use forced variant if provided via data attribute, otherwise A/B test
      const forcedVariant = this.dataset.forcedVariant?.trim();
      let chosen: Element | null = null;
      if (forcedVariant) {
        chosen = this.querySelector(`.lead-variant[data-variant="${forcedVariant}"]`) ?? variants[0];
      } else {
        chosen = variants[Math.floor(Math.random() * variants.length)];
      }
      if (!chosen) return;

      variants.forEach((variant) => {
        if (variant !== chosen) {
          variant.remove();
        }
      });

      (chosen as HTMLElement).classList.remove('hidden');

      const chosenVariantId = (chosen as HTMLElement).dataset.variant;
      const chosenFreeSection = chosen.querySelector('[id^="free-"]') as HTMLElement | null;
      if (chosenFreeSection) {
        chosenFreeSection.id = 'free';
      }

      const chosenCoverLink = chosen.querySelector('a[href^="#free-"]') as HTMLAnchorElement | null;
      if (chosenCoverLink) {
        chosenCoverLink.setAttribute('href', '#free');
      }

      const requestedHash = window.location.hash;
      if (requestedHash === '#free' || requestedHash === `#free-${chosenVariantId}`) {
        requestAnimationFrame(() => {
          document.getElementById('free')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }

      // Set up form submission
      const form = chosen.querySelector('.lead-form') as HTMLFormElement | null;
      const successDiv = chosen.querySelector('.success-message');
      const errorDiv = chosen.querySelector('.error-message');
      const errorText = chosen.querySelector('.error-text');
      const submitButton = chosen.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      const submitText = chosen.querySelector('.submit-text');
      const loadingText = chosen.querySelector('.loading-text');

      if (!form) return;

      const emailInput = form.querySelector('input[name="email"]') as HTMLInputElement | null;
      const emailCheck = form.querySelector('.email-check') as HTMLElement | null;
      const typoCheck = emailInput && emailCheck
        ? attachEmailCheck(emailInput, emailCheck, { suggestionClass: 'hover:text-amber-700' })
        : null;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Stop once per address to point out a likely typo. Submitting the
        // same address again sends it as typed.
        if (typoCheck?.blocksSubmit()) return;

        // Reset messages
        successDiv?.classList.add('hidden');
        errorDiv?.classList.add('hidden');
        if (errorText) errorText.textContent = '';

        // Show loading state
        if (submitButton) {
          submitButton.disabled = true;
          submitText?.classList.add('hidden');
          loadingText?.classList.remove('hidden');
        }

        try {
          const formData = new FormData(form);
          const response = await fetch('/api/newsletter', {
            method: 'POST',
            body: formData,
          });

          const data = await response.json();

          if (data.success) {
            // Show success
            successDiv?.classList.remove('hidden');
          } else {
            if (errorText) errorText.textContent = data.message;
            errorDiv?.classList.remove('hidden');
          }
        } catch (error) {
          if (errorText) errorText.textContent = this.dataset.failed ?? '';
          errorDiv?.classList.remove('hidden');
        } finally {
          if (submitButton) {
            submitButton.disabled = false;
            submitText?.classList.remove('hidden');
            loadingText?.classList.add('hidden');
          }
        }
      });
    }
  }

  customElements.define('lead-generator', LeadGeneratorElement);
</script>
