---
import LeadGenerator from "./LeadGenerator.astro";

interface Props {
  variant?: string;
}

const { variant } = Astro.props;

// Lead-gen (free guide) section is off site-wide for now. It will come back
// built on the Lawmatics lead-gen form; see "Lead generation" in AGENTS.md.
const SHOW_LEAD_GEN = false;
---

{SHOW_LEAD_GEN && <LeadGenerator variant={variant} />}
