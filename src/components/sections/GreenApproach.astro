---
import Button from "../ui/Button.astro";
import CurvedEdge from "../ui/CurvedEdge.astro";
import Icon from "../ui/Icon.astro";
import heroImg from "../../assets/hero-family-leaf-wide.jpg";
import heroImgTall from "../../assets/hero-family-leaf-tall.jpg";
import Markdown from "../ui/Markdown.astro";

interface Props {
  heading: string;
  body: string;
  buttonLabel: string;
  checklist: { title: string; description: string }[];
}

const { heading, body, buttonLabel, checklist } = Astro.props;
---

<section class="pb-30 bg-primary text-text-primary-inverse">
  <div
    class="bg-cover bg-top bg-no-repeat bg-var min-h-[50vh] md:min-h-[80vh] border-b border-b-primary"
    style={`--bg-img: url(${heroImgTall.src}); --bg-img-md: url(${heroImg.src});`}
  >
  </div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-30">
    <CurvedEdge fillColor="fill-primary" />
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2
          class="text-secondary text-3xl sm:text-4xl lg:text-5xl font-serif font-bold mb-6"
        >
          {heading}
        </h2>
        <Markdown content={body} class="text-xl mb-6 leading-relaxed opacity-95" />
        <Button
          href="/services#green-planning"
          variant="secondary"
          class="bg-secondary text-text-primary"
        >
          {buttonLabel}
        </Button>
      </div>

      <div class="relative">
        <div class="bg-white/10 backdrop-blur-sm rounded-lg p-8 space-y-6">
          {
            checklist.map((item) => (
              <div class="flex items-start space-x-4">
                <Icon name="check" size="lg" class="text-secondary" />
                <div>
                  <h3>{item.title}</h3>
                  <Markdown content={item.description} class="opacity-90" />
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
