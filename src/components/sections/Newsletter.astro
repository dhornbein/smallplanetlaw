---
import Button from "../ui/Button.astro";
import heroImg from "../../assets/hero-space.jpg";
import heroImgTall from "../../assets/hero-space-tall.jpg";
import { getSingleton } from "../../utils/content";
import { fillTemplate } from "../../utils/template";

interface Props {
  /** Use "h1" when the signup is the whole page, e.g. /newsletter */
  headingLevel?: "h1" | "h2";
  class?: string;
}

const { headingLevel: Heading = "h2", class: className } = Astro.props;

// All text is edited in Keystatic (Settings > Newsletter signup)
const { signup, fields, emailCheck, messages } = await getSingleton("newsletter");
---

<section
  class:list={[
    "relative py-20 bg-dark text-light bg-var bg-cover bg-center min-h-[40vh]",
    className,
  ]}
  style={`--bg-img: url(${heroImgTall.src}); --bg-img-md: url(${heroImg.src});`}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-8">
      <Heading>{signup.heading}</Heading>
      <p class="text-lg text-gray-300">{signup.intro}</p>
    </div>

    <!-- Wrap the form in a custom element for reactive behavior -->
    <newsletter-form class="block max-w-md mx-auto" data-failed={messages.failed}>
      <form method="POST" action="/api/newsletter">
        <div class="space-y-4">
          <div>
            <label for="email" class="block text-sm font-medium mb-2">
              {fields.emailLabel} *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              aria-describedby="email-check"
              class="w-full px-4 py-3 rounded-md bg-white/30 border border-white/20 text-white placeholder-white/60 focus:outline-none focus:ring-2 focus:ring-secondary focus:border-transparent"
              placeholder={fields.emailPlaceholder}
            />
            <!-- Possible typo in the email, e.g. "gmial.com" -->
            <div
              id="email-check"
              class="email-check mt-2 p-3 rounded-md bg-amber-400/20 border border-amber-400 text-amber-50 text-sm hidden"
              data-suggestion={emailCheck.suggestion}
              data-missing-ending={emailCheck.missingEnding}
              role="status"
              aria-live="polite"
            >
              <p class="email-check-text"></p>
              <p class="email-check-note mt-1 hidden">
                {fillTemplate(emailCheck.submitAgain, { button: signup.submitButton })}
              </p>
            </div>
          </div>

          <div>
            <label for="firstName" class="block text-sm font-medium mb-2">
              {fields.firstNameLabel} *
            </label>
            <input
              type="text"
              id="firstName"
              name="firstName"
              required
              autocomplete="given-name"
              class="w-full px-4 py-3 rounded-md bg-white/30 border border-white/20 text-white placeholder-white/60 focus:outline-none focus:ring-2 focus:ring-secondary focus:border-transparent"
              placeholder={fields.firstNamePlaceholder}
            />
          </div>

          <!-- Spam trap: hidden from people, bots tend to fill it in -->
          <div class="absolute -left-[9999px]" aria-hidden="true">
            <label>
              Leave this field empty
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <Button
            type="submit"
            variant="secondary"
            size="md"
            class="w-full font-medium text-dark hover:bg-secondary/90 hover:text-dark focus:ring-secondary focus:ring-offset-dark disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span class="submit-text">{signup.submitButton}</span>
            <span class="loading-text hidden">{fields.sending}</span>
          </Button>
        </div>

        <!-- Success message -->
        <div
          class="success-message mt-4 p-4 rounded-md bg-green-500/20 border border-green-500 text-green-100 hidden"
          role="alert"
        >
          <p class="font-medium mb-2">{signup.successHeading}</p>
          <p class="text-sm mb-3">{signup.successBody}</p>
          <Button
            type="button"
            size="sm"
            class="reset-form-button block w-full sm:w-auto bg-green-600/40 hover:bg-green-600/60 text-green-100 font-medium focus:ring-green-600"
          >
            {signup.resetButton}
          </Button>
        </div>

        <!-- Error message -->
        <div
          class="error-message mt-4 p-4 rounded-md bg-red-500/20 border border-red-500 text-red-100 hidden"
          role="alert"
        >
          <p class="error-text"></p>
        </div>

        <p class="text-sm text-gray-400 text-center mt-4">{fields.privacy}</p>
      </form>
    </newsletter-form>
  </div>
</section>

<script>
  import { attachEmailCheck } from "../../utils/emailCheckUI";

  // Define behavior for our newsletter form custom element
  class NewsletterForm extends HTMLElement {
    connectedCallback() {
      // Get elements within this custom element instance
      const form = this.querySelector("form");
      const emailInput = this.querySelector('input[name="email"]') as HTMLInputElement | null;
      const successDiv = this.querySelector(".success-message");
      const errorDiv = this.querySelector(".error-message");
      const errorText = this.querySelector(".error-text");
      const submitButton = this.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      const submitText = this.querySelector(".submit-text");
      const loadingText = this.querySelector(".loading-text");
      const resetButton = this.querySelector(".reset-form-button");

      if (!form || !emailInput) return;

      const emailCheck = this.querySelector(".email-check") as HTMLElement | null;
      const typoCheck = emailCheck
        ? attachEmailCheck(emailInput, emailCheck, { suggestionClass: "hover:text-white" })
        : null;

      // Handle reset button click
      resetButton?.addEventListener("click", () => {
        successDiv?.classList.add("hidden");
        form.reset();
        typoCheck?.reset();
      });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        // Stop once per address to point out a likely typo. Submitting the
        // same address again sends it as typed.
        if (typoCheck?.blocksSubmit()) return;

        // Reset messages
        successDiv?.classList.add("hidden");
        errorDiv?.classList.add("hidden");
        if (errorText) errorText.textContent = "";

        // Show loading state
        if (submitButton) {
          submitButton.disabled = true;
          submitText?.classList.add("hidden");
          loadingText?.classList.remove("hidden");
        }

        try {
          const formData = new FormData(form);
          const response = await fetch("/api/newsletter", {
            method: "POST",
            body: formData,
          });

          const data = await response.json();

          if (data.success) {
            // Show success
            successDiv?.classList.remove("hidden");
            form.reset();
            typoCheck?.reset();
          } else {
            // Show error
            if (errorText) errorText.textContent = data.message;
            errorDiv?.classList.remove("hidden");
          }
        } catch (error) {
          // Network error
          if (errorText) errorText.textContent = this.dataset.failed ?? "";
          errorDiv?.classList.remove("hidden");
        } finally {
          // Reset button state
          if (submitButton) {
            submitButton.disabled = false;
            submitText?.classList.remove("hidden");
            loadingText?.classList.add("hidden");
          }
        }
      });
    }
  }

  // Register the custom element
  customElements.define("newsletter-form", NewsletterForm);
</script>
