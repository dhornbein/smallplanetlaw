---
// TEMP: dev-only switcher for the events page design states
import { PREVIEW_STATES } from "../../utils/eventsPreview";

const state = Astro.url.searchParams.get("preview") ?? "live";
---

<nav class="preview-bar" aria-label="Events page preview">
  <strong>Events</strong>
  {
    PREVIEW_STATES.map((option) => (
      <a href={`?preview=${option}`} class:list={{ active: option === state }}>
        {option}
      </a>
    ))
  }
</nav>

<style>
  .preview-bar {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 60;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    background: #1d2324;
    color: white;
    font-size: 0.8rem;

    a {
      margin-left: 0.5rem;
      text-decoration: underline;
    }

    a.active {
      color: #92e1a7;
      font-weight: 700;
      text-decoration: none;
    }
  }
</style>
