---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import CurvedEdge from "../components/ui/CurvedEdge.astro";
import CTA from "../components/sections/CTA.astro";
import Newsletter from "../components/sections/Newsletter.astro";
import Markdown from "../components/ui/Markdown.astro";
import { bgVarStyle, getSettings, getSingleton } from "../utils/content";

const { seo, hero, story, bio } = await getSingleton("aboutPage");
const { callToAction } = await getSettings();
---

<Layout title={seo.title} description={seo.description}>
  <!-- Hero Section -->
  <section
    class="hero-section show-header relative px-8 py-24 lg:py-28 min-h-[50vh] bg-cover bg-top bg-fixed bg-var"
    style={bgVarStyle(hero.image, hero.imageTall)}
  >
    <div class="max-w-4xl mx-auto">
      <h1 class="text-text-secondary">{hero.heading}</h1>
      <Markdown content={hero.intro} class="text-xl leading-relaxed max-w-prose" />
    </div>
  </section>

  <!-- Our Story -->
  <section
    class="relative bg-primary text-text-primary-inverse flex flex-col gap-8 px-4 sm:px-6 lg:px-8 pt-10 pb-30"
  >
    <CurvedEdge fillColor="fill-primary" />

    <h2 class="text-secondary text-center">{story.heading}</h2>

    <Markdown
      content={story.body}
      class="text-xl leading-relaxed max-w-prose mx-auto space-y-6"
    />

    <div class="text-center mt-8 space-y-6">
      <Button
        href={callToAction.href}
        target={callToAction.target}
        variant="secondary"
        size="xl"
      >
        {callToAction.name}
      </Button>
      <p class="text-xl">
        <a href="/faq" class="text-secondary hover:underline font-semibold"
          >{story.faqLinkText}</a
        >
      </p>
    </div>
  </section>

  <!-- Meet Bobbie Mooney Section -->
  <section class="relative bg-neutral-warm">
    <CurvedEdge fillColor="fill-neutral-warm" />
    <div
      class="flex flex-col md:flex-row gap-8 max-w-7xl mx-auto items-center md:items-start px-4 sm:px-6 lg:px-8 py-16 lg:py-24 relative"
    >
      {
        bio.portrait && (
          <img
            src={bio.portrait.src}
            alt="Bobbie Mooney"
            class="block w-full max-w-2xl mx-auto rounded-full mb-8 md:sticky md:top-24"
          />
        )
      }
      <div
        class="max-w-prose bg-white/80 backdrop-blur-md rounded-lg p-8 sm:p-10 lg:p-12 space-y-6 text-lg leading-relaxed"
      >
        <h2 class="text-center mb-8 lg:mb-16">{bio.heading}</h2>
        <Markdown content={bio.body} class="space-y-6" />
        {
          bio.signature && (
            <img
              src={bio.signature.src}
              alt="Bobbie Mooney's Signature"
              class="block mx-auto mt-8 max-w-1/2"
            />
          )
        }
      </div>
    </div>
  </section>

  <CTA />
  <Newsletter />
</Layout>
