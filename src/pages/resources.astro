---
import Layout from "../layouts/Layout.astro";
import CurvedEdge from "../components/ui/CurvedEdge.astro";
import Newsletter from "../components/sections/Newsletter.astro";
import fs from "node:fs";
import path from "node:path";

const resourcesDir = path.join(process.cwd(), "public/resources");
const resources = fs
  .readdirSync(resourcesDir)
  .filter((f) => f.endsWith(".pdf"))
  .map((filename) => ({
    title: filename.replace(/\.pdf$/i, "").replace(/-/g, " "),
    file: `/resources/${filename}`,
  }));
---

<Layout
  title="Free Resources | Small Planet Law"
  description="Download free estate planning guides and resources from Small Planet Law, including tips on choosing an estate planning attorney and green estate planning options."
>
  <!-- Hero Section -->
  <section
    class="bg-secondary text-primary-variant show-header relative px-8 py-24 lg:py-28"
  >
    <div class="max-w-4xl mx-auto">
      <h1>Free Resources</h1>
      <p class="text-xl leading-relaxed max-w-prose">
        Download our guides to help you feel informed and empowered as you plan
        for the people and planet you love.
      </p>
    </div>
  </section>

  <!-- Resources List -->
  <section
    class="relative bg-primary text-text-primary-inverse flex flex-col gap-8 px-4 sm:px-6 lg:px-8 pt-10 pb-30"
  >
    <CurvedEdge fillColor="fill-primary" />

    <div class="max-w-3xl mx-auto w-full">
      <ul class="divide-y divide-white/20">
        {
          resources.map((resource) => (
            <li class="flex items-center gap-4 py-5">
              <div class="flex items-center gap-3 flex-1 min-w-0">
                <svg
                  class="w-5 h-5 shrink-0 text-secondary"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 1.5L18.5 9H13V3.5zM6 20V4h5v7h7v9H6z" />
                </svg>
                <span class="text-base font-semibold leading-snug truncate">
                  {resource.title}
                </span>
              </div>
              <div class="flex items-center gap-3 shrink-0">
                <button
                  class="copy-url-btn text-sm text-white/70 hover:text-secondary transition-colors duration-200 flex items-center gap-1"
                  data-url={resource.file}
                  aria-label={`Copy link to ${resource.title}`}
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                  <span class="copy-label">Copy link</span>
                </button>
                <a
                  href={resource.file}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-secondary hover:text-white transition-colors duration-200"
                  aria-label={`Download ${resource.title}`}
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                  </svg>
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Newsletter />
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-url-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const path = btn.dataset.url!;
      const url = `${window.location.origin}${path}`;
      await navigator.clipboard.writeText(url);
      const label = btn.querySelector(".copy-label")!;
      label.textContent = "Copied!";
      setTimeout(() => (label.textContent = "Copy link"), 2000);
    });
  });
</script>
