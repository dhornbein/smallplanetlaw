---
import Layout from "../layouts/Layout.astro";
import CurvedEdge from "../components/ui/CurvedEdge.astro";
import EventCard from "../components/sections/EventCard.astro";
import EventRegistrationForm from "../components/sections/EventRegistrationForm.astro";
import Newsletter from "../components/sections/Newsletter.astro";
import { getHeroLede, splitTemplate } from "../utils/eventsHero";
import { getUpcomingEvents } from "../utils/lawmatics";
import { getSettings, getSingleton } from "../utils/content";
import { LAWMATICS } from "../utils/site";

// Rendered on demand (and cached at the CDN) so live event details stay current
export const prerender = false;

const { seo, hero, status, card, registration } = await getSingleton("eventsPage");
const { callToAction } = await getSettings();

// Live event details enhance the page; without them the embedded form still works
const events = await getUpcomingEvents(LAWMATICS.eventRegistrationForm.id);

// Only cache successful lookups so a Lawmatics outage clears on the next request
if (events !== null) {
  Astro.response.headers.set(
    "Cache-Control",
    "public, max-age=0, must-revalidate",
  );
  Astro.response.headers.set(
    "Netlify-CDN-Cache-Control",
    "public, durable, s-maxage=300, stale-while-revalidate=3600",
  );
}

const hasEvents = events !== null && events.length > 0;
// A failed lookup keeps the form: we can't tell that registration is closed
const showForm = events === null || events.some((event) => !event.isFull);
const lede = getHeroLede(events, status);
const discoveryCall = splitTemplate(
  hero.discoveryCall,
  "link",
  hero.discoveryCallLink,
);
---

<Layout title={seo.title} description={seo.description}>
  <!-- Page Header -->
  <header
    class="bg-outer-space text-white show-header relative px-8 py-20 lg:py-24"
  >
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1>{hero.heading}</h1>
      <!-- Static intro and live status share a paragraph to keep the header short -->
      <p class="text-lg lg:text-xl text-olivine-100 max-w-prose">
        {hero.intro}{" "}
        <span class="text-white font-semibold">
          {lede.before}{lede.inserted && <span class="font-serif italic">{lede.inserted}</span>}{lede.after}
        </span>
      </p>
      <p class="mt-4 text-base text-outer-space-100 max-w-prose">
        {discoveryCall.before}{discoveryCall.inserted && (
          <a
            href={callToAction.href}
            target={callToAction.target}
            rel="noopener noreferrer"
            class="text-white underline decoration-olivine underline-offset-4 hover:text-olivine-300"
          >{discoveryCall.inserted}</a>
        )}{discoveryCall.after}
      </p>
    </div>
    {
      !hasEvents && !showForm && (
        <CurvedEdge fillColor="fill-outer-space" position="bottom" />
      )
    }
  </header>

  <!-- Event List -->
  {
    hasEvents && (
      <section class="py-16 lg:py-20 relative bg-light">
        <CurvedEdge fillColor="fill-light" />
        <ul class="flex flex-wrap gap-6 sm:gap-8 px-6 md:px-16 justify-center">
          {events.map((event) => (
            <li class="w-full md:max-w-md">
              <EventCard event={event} content={card} />
            </li>
          ))}
        </ul>
        {!showForm && <CurvedEdge fillColor="fill-light" position="bottom" />}
      </section>
    )
  }

  <!-- Registration -->
  {
    showForm && (
      <section class="relative bg-primary text-text-primary-inverse px-4 sm:px-6 lg:px-8 pt-10 pb-30">
        <CurvedEdge fillColor="fill-primary" />

        <div class="max-w-2xl mx-auto w-full">
          <!-- Margin clears the header, which also drops out of the page flow as it sticks -->
          <h2 id="register" class="text-center scroll-mt-48">
            {registration.heading}
          </h2>
          <p class="text-xl leading-relaxed mb-10 text-center">
            {registration.body}
          </p>
          <EventRegistrationForm content={registration} />
        </div>

        <CurvedEdge fillColor="fill-primary" position="bottom" />
      </section>
    )
  }

  <Newsletter />
</Layout>
