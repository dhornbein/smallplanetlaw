---
import Layout from "../layouts/Layout.astro";
import CurvedEdge from "../components/ui/CurvedEdge.astro";
import EventRegistrationForm from "../components/sections/EventRegistrationForm.astro";
import Newsletter from "../components/sections/Newsletter.astro";
---

<Layout
  title="Events | Small Planet Law"
  description="Join Small Planet Law for upcoming workshops and community events on estate planning and green legacy giving in Colorado. See what's coming up and register online."
>
  <!-- Hero Section -->
  <section
    class="bg-secondary text-primary-variant show-header relative px-8 py-24 lg:py-28"
  >
    <div class="max-w-4xl mx-auto">
      <h1>Events</h1>
      <p class="text-xl leading-relaxed max-w-prose">
        Workshops, community gatherings, and educational events on estate
        planning and green legacy giving.
      </p>
    </div>
  </section>

  <!-- Registration -->
  <section
    class="relative bg-primary text-text-primary-inverse px-4 sm:px-6 lg:px-8 pt-10 pb-30"
  >
    <CurvedEdge fillColor="fill-primary" />

    <div class="max-w-2xl mx-auto w-full">
      <h2 class="text-center">Upcoming Events</h2>
      <p class="text-xl leading-relaxed mb-10 text-center">
        Choose an event below and share your details to save your spot.
      </p>
      <EventRegistrationForm />
    </div>

    <CurvedEdge fillColor="fill-primary" position="bottom" />
  </section>

  <Newsletter />
</Layout>
