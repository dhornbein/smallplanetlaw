---
import Markdown from "../../components/ui/Markdown.astro";
import Layout from "../../layouts/Layout.astro";
import PostList from "../../components/sections/PostList.astro";
import CurvedEdge from "../../components/ui/CurvedEdge.astro";
import Newsletter from "../../components/sections/Newsletter.astro";
import { getCollection } from "astro:content";
import { getSingleton } from "../../utils/content";

const { seo, hero } = await getSingleton("blogPage");
const posts = await getCollection("blog");
---

<Layout title={seo.title} description={seo.description}>
  <!-- Page Header -->
  <header class="bg-primary-variant text-white show-header relative px-8 py-24 lg:py-28">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-white">{hero.heading}</h1>
      <Markdown content={hero.intro} class="text-lg lg:text-xl text-olivine-100 max-w-prose" />
    </div>
  </header>

  <!-- Post List -->
  <section class="py-16 lg:py-20 relative bg-light">
    <CurvedEdge fillColor="fill-light" />
    <PostList posts={posts} />
    <CurvedEdge fillColor="fill-light" position="bottom" />
  </section>

  <Newsletter />
</Layout>
