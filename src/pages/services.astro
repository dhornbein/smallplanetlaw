---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import CurvedEdge from "../components/ui/CurvedEdge.astro";
import CTA from "../components/sections/CTA.astro";
import Newsletter from "../components/sections/Newsletter.astro";
import Markdown from "../components/ui/Markdown.astro";
import { bgVarStyle, getSettings, getSingleton } from "../utils/content";

const { seo, hero, approach, offer, green, closingHeading } =
  await getSingleton("servicesPage");
const { callToAction } = await getSettings();
---

<Layout title={seo.title} description={seo.description}>
  <!-- Hero Section -->
  <section
    class="hero-section show-header relative px-8 py-24 lg:py-28 min-h-[80vh] -mt-20 flex flex-col items-start lg:pl-[40vw] lg:justify-center justify-start bg-cover bg-bottom-left bg-fixed bg-var"
    style={bgVarStyle(hero.image, hero.imageTall)}
  >
    <h1 class="text-text-secondary">{hero.heading}</h1>
    <Markdown content={hero.intro} class="text-xl leading-relaxed max-w-prose" />
  </section>

  <!-- Our Approach -->
  <section
    class="relative bg-primary text-text-primary-inverse flex flex-col gap-8 px-4 sm:px-6 lg:px-8 pt-10 pb-30"
  >
    <CurvedEdge fillColor="fill-primary" />

    <h2 class="text-secondary text-center">{approach.heading}</h2>

    <Markdown
      content={approach.body}
      class="text-2xl leading-relaxed max-w-prose mx-auto space-y-6"
    />

    <!-- Client-Centered Features Grid -->
    <div
      class="max-w-7xl mx-auto mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
    >
      {
        approach.features.map((feature) => (
          <div class="bg-primary-variant/40 rounded-lg p-8">
            <h3 class="text-secondary mb-3">{feature.title}</h3>
            <Markdown content={feature.description} class="opacity-90 leading-relaxed" />
          </div>
        ))
      }
    </div>
    <div class="mt-20 text-center">
      <Button
        href={callToAction.href}
        target={callToAction.target}
        variant="secondary"
        size="xl"
      >
        {callToAction.name}
      </Button>
      <p class="text-xl mt-4 text-center">
        <a
          href={approach.link.href}
          class="text-secondary hover:underline font-semibold"
          >{approach.link.label}</a
        >
      </p>
    </div>
  </section>

  <!-- What We Offer -->
  <section class="relative py-20 bg-neutral-warm">
    <CurvedEdge fillColor="fill-neutral-warm" />
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-center mb-6">{offer.heading}</h2>
      <Markdown
        content={offer.body}
        class="text-xl text-justify leading-relaxed max-w-3xl mx-auto mb-8"
      />

      <!-- Services Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          offer.services.map((service) => (
            <div class="bg-white/60 rounded-lg p-8">
              <h3 class="text-primary mb-4">{service.title}</h3>
              <Markdown content={service.description} class="leading-relaxed" />
            </div>
          ))
        }
      </div>
      <div class="mt-20 text-center">
        <Button
          href={callToAction.href}
          target={callToAction.target}
          variant="primary"
          size="xl"
        >
          {callToAction.name}
        </Button>
        <p class="text-xl mt-4 text-center">
          <a
            href={offer.link.href}
            class="text-primary hover:underline font-semibold"
            >{offer.link.label}</a
          >
        </p>
      </div>
    </div>
  </section>

  <!-- Green Estate Planning Section -->
  <section
    id="green-planning"
    class="relative bg-primary text-text-primary-inverse px-4 sm:px-6 lg:px-8 pt-20 pb-30"
  >
    <CurvedEdge fillColor="fill-primary" />

    <div class="max-w-7xl mx-auto">
      <h2 class="text-secondary text-center mb-6">{green.heading}</h2>

      <Markdown
        content={green.body}
        class="text-xl text-justify leading-relaxed max-w-3xl mx-auto space-y-6 mb-16"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
        {
          green.features.map((feature) => (
            <div class="bg-primary-variant/40 rounded-lg p-8">
              <h3 class="text-secondary mb-4">{feature.title}</h3>
              <Markdown content={feature.description} class="opacity-90 leading-relaxed" />
            </div>
          ))
        }
      </div>

      <Markdown
        content={green.closing}
        class="text-lg text-center leading-relaxed max-w-3xl mx-auto"
      />
      <p class="text-lg text-center max-w-3xl mx-auto mt-6">
        <a
          href={green.link.href}
          class="text-secondary hover:underline font-semibold"
          >{green.link.label}</a
        >
      </p>
    </div>
    <CurvedEdge fillColor="fill-primary" position="bottom" />
  </section>

  <!-- Start Your Plan CTA Section -->
  <section class="py-20 bg-neutral-cool relative">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="mb-8 mt-4">{closingHeading}</h2>

      <Button
        href={callToAction.href}
        target={callToAction.target}
        variant="primary"
        size="xl"
      >
        {callToAction.name}
      </Button>
    </div>
    <CurvedEdge fillColor="fill-neutral-cool" position="bottom" />
  </section>

  <Newsletter />
</Layout>
