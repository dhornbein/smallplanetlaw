---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import CurvedEdge from "../components/ui/CurvedEdge.astro";
import Icon from "../components/ui/Icon.astro";
import CTA from "../components/sections/CTA.astro";
import Newsletter from "../components/sections/Newsletter.astro";
import leaf from "../assets/leaf.jpg";
import { Image } from "astro:assets";
import Markdown from "../components/ui/Markdown.astro";
import { getSettings, getSingleton } from "../utils/content";

const { seo, intro, callout, leadIn, faqLink, features, buttonLabel } =
  await getSingleton("greenPlanningPage");
const { callToAction } = await getSettings();
---

<Layout title={seo.title} description={seo.description}>
  <section>
    <div class="p-8 bg-neutral-cool">
      <div class="max-w-7xl mx-auto">
        <Image src={leaf} alt="Leaf" class="mx-auto max-h-80 w-auto" />

        <h1 class="text-text-secondary">{intro.heading}</h1>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center my-20">
          <Markdown
            content={intro.body}
            class="text-xl mb-6 leading-relaxed pt-8"
          />
          <div class="bg-honeydew-600 rounded-lg p-8 self-stretch shadow-lg">
            <h3>{callout.heading}</h3>
            <Markdown content={callout.body} class="text-lg leading-relaxed" />
          </div>
        </div>
      </div>
    </div>

    <div
      class="show-header relative bg-primary text-text-primary-inverse px-4 sm:px-6 lg:px-8 pt-10 pb-30"
    >
      <CurvedEdge fillColor="fill-primary" />

      <p class="text-lg text-center -mt-8 mb-4 leading-relaxed mx-auto">
        {leadIn}
      </p>
      <p class="text-lg text-center mb-16">
        <a href={faqLink.href} class="text-secondary hover:underline font-semibold">{faqLink.label}</a>
      </p>

      <!-- Service Features -->
      <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          features.map((feature) => (
            <div class="bg-white/10 rounded-lg p-8">
              <div class="flex items-start space-x-4">
                <Icon name={feature.icon} size="lg" class="text-secondary" />
                <div>
                  <h3>{feature.title}</h3>
                  <Markdown content={feature.description} class="opacity-90 leading-relaxed" />
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Call to Action -->
      <div class="mt-16 text-center">
        <Button href={callToAction.href} target={callToAction.target} size="xl" variant="secondary" class="bg-secondary hover:bg-secondary/80 text-text-primary">
          {buttonLabel}
        </Button>
      </div>
    </div>
  </section>

  <CTA />
  <Newsletter />
</Layout>
