---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { formatTitle, getSettings } from "../utils/content";
import { SITE } from "../utils/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { image = SITE.defaultOgImage } = Astro.props;
const { phone, email, titleSuffix, defaultDescription } = await getSettings();
// Empty strings from unfilled Keystatic SEO fields fall back to the site defaults.
const description = Astro.props.description || defaultDescription;
// `title` is just the page-specific part; the site-wide suffix is added here.
const title = formatTitle(Astro.props.title, titleSuffix);
const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).origin;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url.pathname;
const fullImageURL = Astro.site ? new URL(image, Astro.site).toString() : image;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${SITE.analyticsId}`}></script>
    <script is:inline define:vars={{ analyticsId: SITE.analyticsId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", analyticsId);
    </script>

    <link
      rel="icon"
      type="image/svg+xml"
      href={import.meta.env.BASE_URL + "favicon.svg"}
    />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={fullImageURL} />

    <!-- Local Business Schema -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "LegalService",
        name: SITE.name,
        description: SITE.schema.description,
        url: siteUrl,
        logo: `${siteUrl}${SITE.logo}`,
        image: `${siteUrl}${SITE.defaultOgImage}`,
        address: {
          "@type": "PostalAddress",
          addressRegion: SITE.schema.addressRegion,
          addressCountry: SITE.schema.addressCountry,
        },
        priceRange: SITE.schema.priceRange,
        telephone: phone.href.replace(/^tel:/, ""),
        email: email.display,
        areaServed: {
          "@type": "State",
          name: SITE.schema.areaServed,
        },
      })}
    ></script>
  </head>
  <body class="bg-background text-text-primary font-sans">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
